# ==============================================================================
# India Weather Forecasting & Intelligence System — Environment Configuration Template
# DO NOT COMMIT SENSITIVE VALUES, SECRETS, OR ACTUAL PASSWORDS TO VERSION CONTROL
# ==============================================================================

# Application & Environment
PROJECT_NAME="India Weather Forecasting & Intelligence System"
ENVIRONMENT=development
LOG_LEVEL=INFO

# Backend Server Configuration (FastAPI / Uvicorn)
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
API_V1_STR=/api/v1

# CORS Allowed Origins (Comma-separated or JSON list)
BACKEND_CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173", "http://localhost:3000"]

# Frontend Configuration (Vite React)
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Optional Database (MongoDB)
DATABASE_URL=mongodb://localhost:27017/weather_intelligence
MONGODB_COLLECTION_STATIONS=stations
MONGODB_COLLECTION_WEATHER=weather_observations
MONGODB_COLLECTION_FORECASTS=forecast_results
MONGODB_COLLECTION_MODELS=model_metadata

# Authoritative Paths (Defaults are relative to workspace root)
# CANONICAL_PARQUET_PATH=phase2_canonical/outputs/canonical_weather_full.parquet
# CANONICAL_STATIONS_PATH=phase2_canonical/outputs/station_metadata.json
