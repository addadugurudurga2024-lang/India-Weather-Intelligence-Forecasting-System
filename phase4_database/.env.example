# MongoDB & Database Configuration Template
# DO NOT COMMIT SENSITIVE VALUES OR ACTUAL PASSWORDS TO VERSION CONTROL

# ==============================================================================
# Database Connection Settings (Phase 4 Foundation / Phase 8 Backend Access)
# ==============================================================================

# MongoDB Connection URI
# Local MongoDB Community Edition default:
MONGODB_URI=mongodb://localhost:27017

# Target Database Name
MONGODB_DATABASE=india_weather_intelligence

# Optional Auth (If authentication enabled in MongoDB instance)
# MONGODB_USERNAME=weather_admin
# MONGODB_PASSWORD=your_secure_password_here
# MONGODB_AUTH_SOURCE=admin

# Collection Names
MONGODB_COLLECTION_STATIONS=stations
MONGODB_COLLECTION_WEATHER=weather_observations
MONGODB_COLLECTION_FORECASTS=forecast_results
MONGODB_COLLECTION_MODELS=model_metadata

# Max Connection Pool Size
MONGODB_MAX_POOL_SIZE=50
MONGODB_TIMEOUT_MS=5000
